.env
*.key
.DS_Store
**/secrets*
node_modules/

# Obsidian volatile UI state
.obsidian/workspace.json

# Headless loop run logs (artifacts are committed; per-run logs are noise)
loops/_runtime/
# host-local sync stamp for runtime/heartbeat.sh; the beats themselves ARE committed
loops/_health/.last-sync

# Sadie Reddit creds (local only)
.yourco/
*.env
.env.*
**/.env.*

# Python build artifacts
__pycache__/
*.pyc

# Melanie Phase 2 keys (never commit)
dashboard/melanie.env

# Slack listener tokens (Phase 2 — never commit)
runtime/.slack.env
.slack.env

# CRM cross-process write lock (runtime only, never committed)
crm/.data.lock
# derived: rebuilt from git history, keyed to the data.json HEAD sha.
# NOTE: .gitignore has no INLINE comments — a trailing "# ..." becomes part of the pattern,
# which is why this file was tracked for weeks despite "being ignored" (caught 2026-08-07).
crm/_ghost-cache.json

# Portable repo lock (runtime only, never committed)
.repo-sync.lock/

# Global loop pause switch (host-local; set on the VPS to pause all loops — see runtime/README.md)
runtime/.paused

# Connector OS generated output (regenerate on demand; never source of truth)
processes/partnerships/connector-console/_out/
agents/bird/connector-demos/

# Connector Console credential + session stores (scrypt hashes, salts, setup-token hashes,
# live session ids). NEVER commit — a leaked store is every connector's account.
processes/partnerships/connector-console/_auth.json
processes/partnerships/connector-console/_sessions.json
processes/partnerships/connector-console/_auth.json.lock
processes/partnerships/connector-console/_sessions.json.lock
processes/partnerships/connector-console/_auth.json.tmp.*
processes/partnerships/connector-console/_sessions.json.tmp.*

# Playground — synthetic data is regenerated by playground/seed.py, never committed
playground/data/
playground/.pids
playground/.crm.log
playground/.hq.log
playground/.console.log

# A stray clone of this repo was committed into itself on 2026-08-11 by git-sync.sh (add -A).
# 346MB, 924 duplicate .md files, doubling every repo-wide search. Never again.
yourco-os/

# inbox/ is a LOCAL staging area, not storage (see inbox/_README.md). Text notes are tracked so a
# dropped thought survives a machine; binaries are not — an artifact worth keeping gets committed in
# its DESTINATION folder after routing, not here.
inbox/*
!inbox/_README.md
!inbox/*.md
!inbox/*.txt
