[Unit]
Description=YourCo monthly answer-engine visibility audit (Cora — AEO/GEO)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh aeo-geo
TimeoutStartSec=900
