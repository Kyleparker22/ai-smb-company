[Unit]
Description=YourCo daily desk — inbox triage + call prep (Jim)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh inbox-triage
TimeoutStartSec=900
