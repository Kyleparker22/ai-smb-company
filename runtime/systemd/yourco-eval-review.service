[Unit]
Description=YourCo weekly eval review — cross-agent QA (Kolby)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh eval-review
TimeoutStartSec=900
