[Unit]
Description=YourCo weekly source-watch — triage new videos/articles from named sources (Brett)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh source-watch
TimeoutStartSec=900
