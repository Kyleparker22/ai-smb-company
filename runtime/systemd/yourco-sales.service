[Unit]
Description=YourCo sales/pipeline loop (Atlas)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh sales
TimeoutStartSec=900
