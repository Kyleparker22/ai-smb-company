[Unit]
Description=YourCo content cadence loop (Katie)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh content
TimeoutStartSec=900
