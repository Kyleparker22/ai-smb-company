[Unit]
Description=YourCo weekly inbox-signal — scrub subscribed AI/business mail for landscape signal (Brett)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh inbox-signal
TimeoutStartSec=900
