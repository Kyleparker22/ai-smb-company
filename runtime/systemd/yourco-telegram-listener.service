[Unit]
Description=yourco Telegram per-agent command listener (phone control surface)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claudeops
Group=claudeops
WorkingDirectory=/home/claudeops/yourco-os
EnvironmentFile=/home/claudeops/yourco-os/runtime/.telegram.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/claudeops/yourco-os/runtime/telegram-agent-listener.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
