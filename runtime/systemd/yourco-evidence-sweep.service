[Unit]
Description=YourCo weekly evidence sweep — trust ledger, immune drills, trip-wires, vacancies (Kolby)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh evidence-sweep
TimeoutStartSec=900
