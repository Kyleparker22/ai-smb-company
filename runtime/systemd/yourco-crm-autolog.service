[Unit]
Description=YourCo crm-autolog — Gmail/Calendar to pending CRM activities, confirm-to-save (David)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh crm-autolog
TimeoutStartSec=1800
