[Unit]
Description=YourCo demo-prep — personalize Email-1 demos for new prospects (staged; never sends)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh demo-prep
TimeoutStartSec=900
