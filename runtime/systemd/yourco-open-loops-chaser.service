[Unit]
Description=YourCo open-loops chaser — pending human actions as a queue with ages (Jim)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/home/claudeops/yourco-os/runtime/run-loop.sh open-loops-chaser
TimeoutStartSec=900
