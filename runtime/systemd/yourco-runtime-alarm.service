[Unit]
Description=YourCo runtime alarm — API-independent failure/credit check; posts to Slack on a FAILED run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claudeops
Environment=HOME=/home/claudeops
WorkingDirectory=/home/claudeops/yourco-os
ExecStart=/bin/bash /home/claudeops/yourco-os/runtime/runtime-alarm.sh
TimeoutStartSec=120
